{"@context":{"@vocab":"https://55515-code.github.io/open-provenance-knowledge/vocab/","id":"@id","source":{"@id":"source","@type":"@id"},"type":"@type"},"@graph":[{"claim":"CycloneDX 1.7 defines a modular bill-of-materials model for components, services, dependencies, vulnerabilities, formulation, declarations, and related supply-chain information.","id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/cyclonedx/1.7","name":"CycloneDX 1.7","source":["source:cyclonedx-1.7"],"type":"StandardProfile"},{"claim":"The in-toto Attestation Framework 1.2 defines statement, predicate, envelope, and bundle layers for authenticated metadata about software artifacts.","id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/in-toto-attestation/1.2","name":"in-toto Attestation Framework 1.2","source":["source:in-toto-attestation-1.2"],"type":"StandardProfile"},{"claim":"SLSA 1.2 defines incrementally adoptable supply-chain security levels and recommended attestation formats; it is not an SBOM format.","id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/slsa/1.2","name":"SLSA 1.2","source":["source:slsa-1.2"],"type":"StandardProfile"},{"claim":"SPDX 3.0.1 defines an RDF-based model and serializations for software, licensing, security, build, and supply-chain information, including SBOM use cases.","id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/spdx/3.0.1","name":"SPDX 3.0.1","source":["source:spdx-3.0.1"],"type":"StandardProfile"},{"id":"relationship:in-toto-cyclonedx-predicate","note":"CycloneDX recognizes a BOM predicate type usable in in-toto attestations.","object_id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/cyclonedx/1.7","predicate":"defines-predicate","source_ids":["source:in-toto-attestation-1.2","source:cyclonedx-1.7"],"status":"supported","subject_id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/in-toto-attestation/1.2","type":"relationship"},{"id":"relationship:in-toto-spdx-predicate","note":"The in-toto predicate registry includes SPDX predicate forms; this does not make SPDX and in-toto equivalent.","object_id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/spdx/3.0.1","predicate":"defines-predicate","source_ids":["source:in-toto-attestation-1.2","source:spdx-3.0.1"],"status":"supported","subject_id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/in-toto-attestation/1.2","type":"relationship"},{"id":"relationship:slsa-uses-in-toto","note":"SLSA's recommended provenance is expressed as a predicate within an in-toto Statement.","object_id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/in-toto-attestation/1.2","predicate":"uses-envelope","source_ids":["source:slsa-1.2","source:in-toto-attestation-1.2"],"status":"supported","subject_id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/slsa/1.2","type":"relationship"},{"id":"relationship:spdx-cyclonedx-not-equivalent","note":"Both can represent SBOM information, but their models, scopes, and serializations are not interchangeable without a defined mapping.","object_id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/cyclonedx/1.7","predicate":"not-equivalent-to","source_ids":["source:spdx-3.0.1","source:cyclonedx-1.7"],"status":"supported","subject_id":"https://55515-code.github.io/open-provenance-knowledge/id/standard/spdx/3.0.1","type":"relationship"}]}
