{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://55515-code.github.io/open-provenance-knowledge/schemas/summary.schema.json",
  "type": "object",
  "required": ["id", "type", "record_ids", "one_sentence", "retrieval", "executive", "evidence", "disagreement", "provenance", "change", "generation_method", "generated_at", "human_reviewed", "source_cutoff", "known_omissions", "content_hash"],
  "properties": {
    "id": {"type": "string", "pattern": "^summary:"},
    "type": {"const": "summary"},
    "record_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "one_sentence": {"type": "string"},
    "retrieval": {"type": "string"},
    "executive": {"type": "string"},
    "evidence": {"type": "string"},
    "disagreement": {"type": "string"},
    "provenance": {"type": "string"},
    "change": {"type": "string"},
    "generation_method": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "human_reviewed": {"type": "boolean"},
    "source_cutoff": {"type": "string", "format": "date"},
    "known_omissions": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

