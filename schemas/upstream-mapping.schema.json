{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://55515-code.github.io/open-provenance-knowledge/schemas/upstream-mapping.schema.json",
  "type": "object",
  "required": ["id", "type", "target", "contribution_url", "requirements_verified_at", "mapped_record_ids", "proposed_payload", "status", "synchronization"],
  "properties": {
    "id": {"type": "string", "pattern": "^upstream:"},
    "type": {"const": "upstream-mapping"},
    "target": {"type": "string"},
    "contribution_url": {"type": "string", "format": "uri"},
    "requirements_verified_at": {"type": "string", "format": "date"},
    "mapped_record_ids": {"type": "array", "items": {"type": "string"}},
    "proposed_payload": {"type": "string"},
    "status": {"enum": ["draft", "submitted", "accepted", "rejected", "revision-requested"]},
    "synchronization": {"type": "string"}
  },
  "additionalProperties": false
}

